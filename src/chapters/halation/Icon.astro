---
/** One of Halation's 20×20 stroke icons (icons.ts). Always decorative. */
import { ICONS } from './icons';

interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['hx-icon', className]}
  viewBox="0 0 20 20"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name] ?? ''}
/>
