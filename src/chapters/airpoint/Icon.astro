---
/**
 * A few of Airpoint's own icons (android/.../ui/icons/AirIcons.kt): 24 dp, 1.8 dp round
 * strokes that match the Loop's terminals. Always decorative here.
 */
const ICONS = {
  stylus: { strokes: ['M4 20L5.98 15.62L17.65 3.95A1.7 1.7 0 0 1 20.05 6.35L8.38 18.02Z'], fills: [] },
  monitor: {
    strokes: [
      'M4.25 4.5h15.5a1.75 1.75 0 0 1 1.75 1.75v9a1.75 1.75 0 0 1-1.75 1.75H4.25A1.75 1.75 0 0 1 2.5 15.25v-9A1.75 1.75 0 0 1 4.25 4.5z',
      'M9 20.5h6',
      'M12 17v3.5',
    ],
    fills: [],
  },
  check: { strokes: ['M5 12.5l4.25 4.25L19 7'], fills: [] },
  arrowRight: { strokes: ['M5 12h14', 'M13 6l6 6-6 6'], fills: [] },
  chevronRight: { strokes: ['M9.5 6l6 6-6 6'], fills: [] },
  auto: { strokes: ['M12 4a8 8 0 1 1 0 16a8 8 0 1 1 0-16z'], fills: ['M12 4a8 8 0 0 0 0 16z'] },
  code: { strokes: ['M8.5 7.5L4 12l4.5 4.5', 'M15.5 7.5L20 12l-4.5 4.5', 'M13.25 5.5l-2.5 13'], fills: [] },
  stop: { strokes: [], fills: ['M8 6.5h8a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 16V8A1.5 1.5 0 0 1 8 6.5z'] },
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
const icon = ICONS[name];
---

<svg class:list={['air-icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {icon.strokes.map((d) => <path d={d} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />)}
  {icon.fills.map((d) => <path d={d} fill="currentColor" />)}
</svg>

<style>
  .air-icon {
    display: block;
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>
