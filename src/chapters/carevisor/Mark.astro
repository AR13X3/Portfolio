---
/**
 * CareVisor's mark (public/images/carevisor-mark.png), redrawn as a vector: a heartbeat
 * line that writes "Ai", its i dotted in the light brand blue. Decorative.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['cv-mark', className]} viewBox="0 0 64 64" aria-hidden="true" focusable="false" data-cv-mark>
  <rect width="64" height="64" rx="13" fill="#3567ba"></rect>
  <g fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <path
      d="M6 38.6H13.4C15 38.6 15.6 33 16.6 33S17.9 38.9 18.8 38.9H20L28.2 15L35.8 38.9H40.6C42.6 38.9 43.9 31.7 45.2 31.7S46.9 38.9 48.4 38.9H58"
      data-cv-mark-line></path>
    <path d="M38.2 22.4V38.6" data-cv-mark-line></path>
  </g>
  <path d="M25 27.6H31.6" stroke="#a9c1ea" stroke-width="2.4" stroke-linecap="round" data-cv-mark-bar></path>
  <circle cx="38.2" cy="17.4" r="2" fill="#5ea2f2" data-cv-mark-dot></circle>
</svg>
