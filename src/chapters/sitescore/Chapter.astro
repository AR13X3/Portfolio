---
/**
 * SiteScore, told in SiteScore's own interface: the terminal status strip, the ruled-cell top
 * bar with its numbered screens and sliding red bar, the hex mark, the Overview hero with its
 * opportunity map and model run, then three design decisions as ruled cells beside the
 * workspace's site cards and forecast, the equation ledger, and the real app in a browser.
 * Ported from SiteScore's frontend/src/styles.css and frontend/src/components;
 * the map, cards, chart and ledger are drawn from a run of SiteScore's own API.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import ChapterSection from '../../components/ChapterSection.astro';
import Browser from '../../components/Browser.astro';
import Screen from '../../components/Screen.astro';
import Shot from '../../components/Shot.astro';
import ForecastChart from './ForecastChart.astro';
import HeatDefs from './HeatDefs.astro';
import HeatMap from './HeatMap.astro';
import Ledger from './Ledger.astro';
import Logo from './Logo.astro';
import SiteCards from './SiteCards.astro';
import { AS_OF, SITES } from './data';
import { money, pct } from './format';
import { HEAT_CELLS, HEAT_CUTS } from './heat';
import type { Chapter } from '../types';

interface Props {
  chapter: Chapter;
  index: number;
  next: string;
}
const { chapter, index, next } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const [repo, live] = chapter.links;
const SELECTED = SITES.findIndex((s) => s.rank === 1);
const probe = SITES[SELECTED];
const nav = ['Overview', 'Workspace', 'Evidence', 'Data'];
const title = 'Where should your next business open?';
const dtitle = 'Three decisions behind it';
const CODES = ['forecast.monthly()', 'model.explain(site)', '--signal'];
const ramp = ['less', ...HEAT_CUTS.map((c) => `${money(c)}+`)];
// Sparkline (frontend/src/components/Sparkline.tsx): 300 × 64, the band behind the line.
const SW = 300;
const SH = 64;
const sAll = [...probe.months, ...probe.bandP90, ...probe.bandP10];
const sHi = Math.max(...sAll);
const sx = (i: number) => (i / (probe.months.length - 1)) * SW;
const sy = (v: number) => 4 + (1 - v / sHi) * (SH - 8);
const sLine = probe.months.map((v, i) => `${i ? 'L' : 'M'}${sx(i).toFixed(1)},${sy(v).toFixed(1)}`).join('');
const sBand =
  probe.bandP90.map((v, i) => `${i ? 'L' : 'M'}${sx(i).toFixed(1)},${sy(v).toFixed(1)}`).join('') +
  [...probe.bandP10].reverse().map((v, j) => `L${sx(probe.bandP10.length - 1 - j).toFixed(1)},${sy(v).toFixed(1)}`).join('') +
  'Z';
const sEnd = (sy(probe.months[probe.months.length - 1]) / SH) * 100;
const ghost = 'Compare Church St Parramatta, Harris Park and Wentworth Point';
---

<ChapterSection chapter={chapter} next={next} class="ss">
  <div class="ss-world">
    <HeatDefs />
    <div class="ss-paper" aria-hidden="true" data-ss="paper" data-clear></div>

    <!-- The terminal status strip (StatusStrip.tsx). -->
    <div class="ss-strip ss-mono" aria-hidden="true" data-ss="strip" data-clear>
      <span class="ss-strip__path"><span data-ss="path">sitescore/parramatta/cafe</span><i class="ss-cursor"></i></span>
      <span class="ss-strip__item ss-strip__hide">data <b>6/6 real</b></span>
      <span class="ss-strip__item ss-strip__hide">as_of <b>{AS_OF}</b></span>
      <span class="ss-strip__item ss-strip__hide">last_run <b>simulate</b> <b>2.16s</b><i class="ss-strip__pulse"></i></span>
      <span class="ss-strip__palette"><kbd>Ctrl</kbd><kbd>K</kbd><span class="ss-strip__hide">commands</span></span>
    </div>

    <!-- The top bar: a row of ruled cells (styles.css .topbar). -->
    <header class="ss-top" data-ss="top" data-clear>
      <span class="ss-top__brand" data-ss="brand">
        <Logo />
        <span class="ss-wordmark">sitescore</span>
      </span>
      <span class="ss-nav" aria-hidden="true" data-ss="nav">
        {
          nav.map((label, i) => (
            <span class:list={['ss-nav__link', { 'is-on': i === 0 }]} data-ss="navlink">
              <span class="ss-nav__index ss-mono">{String(i + 1).padStart(2, '0')}</span>
              {label}
            </span>
          ))
        }
        <i class="ss-nav__bar" data-ss="navbar"></i>
      </span>
      <span class="ss-top__controls">
        <span class="ss-top__cell ss-top__badge ss-mono" aria-hidden="true" data-ss="cellr"><i></i>Real data</span>
        <a class="ss-top__cta" href={repo.href} target="_blank" rel="noopener noreferrer" data-ss="cta">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
            ></path>
          </svg>
          <span class="ss-top__cta-text">Star on GitHub</span>
          <span class="visually-hidden"> (opens in a new tab)</span>
          <svg class="ss-top__cta-arrow" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
        </a>
      </span>
    </header>

    <!-- Overview: the hero (HomeView.tsx). -->
    <div class="ss-hero" data-ss="hero" data-clear>
      <div class="ss-hero__copy">
        <p class="ss-meta ss-mono" data-ss="meta">{num}</p>
        <p class="ss-kicker ss-mono" aria-hidden="true">
          <span data-ss="kicker">open-source_location_intelligence/</span><i class="ss-cursor"></i>
        </p>
        <h2 class="ss-title" id={`${chapter.slug}-title`} tabindex="-1" data-focus data-ss="title">
          <span class="visually-hidden">{chapter.name}: </span>
          {
            title.split(' ').map((w, i, all) => (
              <>
                <span class="ss-br" aria-hidden="true" data-ss="word">
                  <span class="ss-br__text">{w}</span>
                  <i class="ss-br__block" />
                </span>
                {i < all.length - 1 ? ' ' : ''}
              </>
            ))
          }
          <span class="visually-hidden">{title}</span>
        </h2>

        <div class="ss-ask" aria-hidden="true" data-ss="ask">
          <span class="ss-ask__prompt ss-mono">ask&gt;</span>
          <span class="ss-ask__field ss-mono"><span class="ss-ask__ghost" data-ss="ghost" data-text={ghost}>{ghost}</span><i class="ss-cursor ss-cursor--ghost"></i></span>
          <span class="ss-ask__go">Ask<svg viewBox="0 0 24 24" width="15" height="15"><path d="M7 17 17 7M8 7h9v9"></path></svg></span>
        </div>

        <ul class="ss-list" data-ss="list">
          <li>
            <a class="ss-list__link" href={repo.href} target="_blank" rel="noopener noreferrer">
              <span class="ss-list__n ss-mono" aria-hidden="true">01</span>
              <span class="ss-list__text"><span class="ss-list__label">Source</span>SiteScore on GitHub</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
            </a>
          </li>
          <li>
            <a class="ss-list__link" href={live.href} target="_blank" rel="noopener noreferrer">
              <span class="ss-list__n ss-mono" aria-hidden="true">02</span>
              <span class="ss-list__text"><span class="ss-list__label">Live app</span>Open SiteScore</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"></path></svg>
            </a>
          </li>
        </ul>
        <p class="ss-demo" data-ss="demo">
          <span class="ss-mono">demo data</span>
        </p>
      </div>

      <figure class="ss-map ss-card" data-ss="map">
        <div class="ss-map__stage">
          <HeatMap probe={probe} label={`SiteScore’s opportunity map, redrawn from its own data: ${HEAT_CELLS.toLocaleString('en-AU')} hex cells 250 m apart across the City of Parramatta, darker where a café’s quick monthly revenue estimate is higher. A pin marks ${probe.label}.`} />
          <span class="ss-map__types" aria-hidden="true" data-ss="maptop">
            <span class="is-on">Café</span><span>Childcare <small>draft</small></span><span>Gym <small>draft</small></span>
          </span>
          <div class="ss-legend-card" data-ss="legend">
            <p class="ss-legend-card__title">Quick estimate, monthly revenue</p>
            <ol class="ss-ramp">
              {
                ramp.map((t, i) => (
                  <li>
                    <i class={`b${i}`} />
                    {t}
                  </li>
                ))
              }
            </ol>
            <p class="ss-legend-card__note">{HEAT_CELLS.toLocaleString('en-AU')} cells, 250 m apart · top 7% darkest</p>
          </div>
        </div>

        <!-- The model run wherever you click (OpportunityMap.tsx .probe-card). -->
        <aside class="ss-probe" aria-label={`Model run for ${probe.label}`} data-ss="probe">
          <span class="ss-probe__head">
            <span class="ss-probe__kicker ss-mono" aria-hidden="true"><span data-ss="decode">model.run(cafe)</span></span>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </span>
          <p class="ss-probe__title">{probe.label}</p>
          <p class="ss-probe__value"><span>{money(probe.total)}</span> <small>revenue over {probe.months.length} months</small></p>
          <div class="ss-spark" role="img" aria-label={`Monthly revenue over ${probe.months.length} months, ramping up from opening`}>
            <svg viewBox={`0 0 ${SW} ${SH}`} preserveAspectRatio="none" aria-hidden="true">
              <path class="ss-spark__band" d={sBand} data-ss="sband"></path>
              <path class="ss-spark__line" d={sLine} data-ss="sline"></path>
            </svg>
            <i class="ss-spark__dot" style={`top:${sEnd}%`} data-ss="sdot"></i>
          </div>
          <dl class="ss-probe__stats">
            <div><dt>Mature month</dt><dd>{money(probe.mature)}</dd></div>
            <div><dt>Area</dt><dd>{probe.area}</dd></div>
            <div><dt>Loss risk</dt><dd>{pct(probe.probLoss)}</dd></div>
          </dl>
          <span class="ss-probe__actions" aria-hidden="true">
            <span class="ss-btn ss-btn--accent" data-ss="open"><i class="ss-btn__wipe" data-ss="openwipe"></i><span>Open in workspace</span><svg viewBox="0 0 24 24" width="14" height="14"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
            <span class="ss-btn ss-btn--ghost">How it’s built</span>
          </span>
        </aside>
      </figure>
    </div>

    <!-- Workspace: the decisions as ruled cells, each beside the screen that shows it. -->
    <div class="ss-dec" data-ss="dec" data-clear>
      <div class="ss-dec__head">
        <p class="ss-kicker ss-mono" aria-hidden="true"><span data-ss="dkicker">workspace/parramatta/cafe</span><i class="ss-cursor"></i></p>
        <h3 class="ss-dec__title" data-ss="dtitle">
          {
            dtitle.split(' ').map((w, i, all) => (
              <>
                <span class="ss-br" aria-hidden="true" data-ss="dword">
                  <span class="ss-br__text">{w}</span>
                  <i class="ss-br__block" />
                </span>
                {i < all.length - 1 ? ' ' : ''}
              </>
            ))
          }
          <span class="visually-hidden">{dtitle}</span>
        </h3>
      </div>
      <ol class="ss-dec__list">
        {
          chapter.decisions.map((d, i) => (
            <li class="ss-d" data-ss="d">
              <div class="ss-cell" data-ss="cell">
                <i class="ss-cell__fill" aria-hidden="true" data-ss="fill" />
                <span class="ss-cell__top ss-mono" aria-hidden="true">
                  <span class="ss-cell__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="ss-cell__code">{CODES[i]}</span>
                </span>
                <h4 class="ss-cell__title">{d.title}</h4>
              </div>
              <div class="ss-scene" data-ss="scene">
                {i === 0 && (
                  <div class="ss-scene__ranges">
                    <ForecastChart selected={SELECTED} />
                    <SiteCards selected={SELECTED} />
                  </div>
                )}
                {i === 1 && <Ledger />}
                {i === 2 && (
                  <div class="ss-scene__app">
                    <Browser url="ar13x3.github.io/SiteScore" label="The SiteScore app">
                      <Screen>
                        <Shot
                          src="shots/sitescore/desktop-workspace-map.webp"
                          alt="SiteScore workspace with three demo sites over the hex heat map. Church St, Parramatta is selected: its card is inverted to ink and its map pin and site key are red, while Harris Park and Wentworth Point stay ink and are told apart by number. The details panel shows its 36-month numbers and why it ranks third."
                          width={2880}
                          height={1800}
                        />
                      </Screen>
                      <Screen>
                        <Shot
                          src="shots/sitescore/desktop-full.webp"
                          alt="The full SiteScore Overview page: the hex heat map with a model run card, the stat band, the equation ledger, four capability cells, the backtest timeline and the contribute card."
                          width={1440}
                          height={2313}
                          scroll
                        />
                      </Screen>
                    </Browser>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</ChapterSection>

<style>
  /* Tokens from frontend/src/styles.css :root (on .ss-world: the <section> belongs to ChapterSection). */
  .ss-world {
    --bg: #efefed;
    --surface: #ffffff;
    --surface-2: #f5f5f3;
    --border: #e4e4e1;
    --border-strong: #d3d3cf;
    --grid: #ececea;
    --text-primary: #161616;
    --text-secondary: #4a4a47;
    /* The app's --text-muted (#8a8a85) is 3:1 on the paper; this is its 4.5:1 step. */
    --text-muted: #6d6d69;
    --ink: #1d1d1d;
    --ink-text: #ffffff;
    --ink-muted: rgb(255 255 255 / 0.55);
    --signal: #e5484d;
    /* Small red text: the ramp's #ac2c26 on light, the dark theme's signal on ink. */
    --signal-text: #ac2c26;
    --signal-on-ink: #ef6b6f;
    /* Red fills under white text (white on #e5484d is 3.9:1): STATUS.critical, theme.ts. */
    --signal-fill: #d03b3b;
    --pos: #3d3d3a;
    --paper-line: rgb(0 0 0 / 0.055);
    --radius: 14px;
    --font: 'Inter Variable', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
    --wipe: cubic-bezier(0.7, 0, 0.2, 1);
    --ss-gutter: clamp(16px, 2.4vw, 32px);
    position: relative;
    z-index: 1;
    color: var(--text-primary);
    font: 400 14px/1.5 var(--font);
    font-feature-settings: 'cv11';
  }

  .ss-world :global(h4) {
    margin: 0;
  }

  .ss-world :focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  .ss-world ::selection {
    background: var(--ink);
    color: var(--ink-text);
  }

  .ss-world :global(.ss-mono) {
    font-family: var(--mono);
    font-feature-settings: normal;
    letter-spacing: 0;
  }

  .ss-world :global(.ss-cursor) {
    display: inline-block;
    width: 0.6em;
    height: 0.95em;
    margin-left: 3px;
    vertical-align: -0.12em;
    background: var(--signal);
    animation: ss-blink 1.1s steps(1) infinite;
  }

  @keyframes ss-blink {
    50% {
      opacity: 0;
    }
  }

  .ss-world :global(.ss-card) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.03);
  }

  /* ---------- Grid paper (styles.css .hero::before) ---------- */
  .ss-paper {
    position: absolute;
    top: 0;
    left: 0;
    width: 75%;
    height: min(100%, 1200px);
    background-image:
      linear-gradient(var(--paper-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--paper-line) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(120% 90% at 0% 0%, #000 30%, transparent 75%);
    mask-image: radial-gradient(120% 90% at 0% 0%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  /* ---------- Status strip ---------- */
  .ss-strip {
    position: relative;
    display: flex;
    align-items: center;
    gap: 22px;
    height: 32px;
    padding: 0 24px;
    overflow: hidden;
    background: #0d0d0d;
    color: #d8d8d4;
    font-size: 12px;
    line-height: 1;
    border-bottom: 1px solid #222;
    white-space: nowrap;
  }

  .ss-strip b {
    font-weight: 500;
    color: #fff;
  }

  .ss-strip__path {
    color: #fff;
  }

  .ss-strip__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #8f8f8a;
  }

  .ss-strip__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    animation: ss-blink 2s steps(1) infinite;
  }

  .ss-strip__palette {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    height: 22px;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid #2c2c2c;
    color: #a5a5a0;
  }

  .ss-strip__palette span {
    margin-left: 4px;
  }

  .ss-strip kbd {
    display: inline-grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 4px;
    font: 500 10.5px/1 var(--mono);
    border: 1px solid #333;
    background: #181818;
    color: #cfcfca;
  }

  @media (max-width: 760px) {
    .ss-strip {
      padding: 0 16px;
      gap: 12px;
    }

    .ss-strip__hide {
      display: none !important;
    }
  }

  /* ---------- Top bar ---------- */
  .ss-top {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    height: 64px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .ss-top__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 22px 0 20px;
    border-right: 1px solid var(--border);
  }

  .ss-top__brand :global(.ss-logo) {
    color: var(--ink);
  }

  .ss-wordmark {
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .ss-nav {
    position: relative;
    display: flex;
    overflow: hidden;
  }

  .ss-nav__link {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    width: 150px;
    flex: none;
    padding: 9px 14px 11px;
    border-right: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }

  .ss-nav__index {
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .ss-nav__link.is-on {
    color: var(--text-primary);
  }

  .ss-nav__link.is-on .ss-nav__index {
    color: var(--signal-text);
  }

  .ss-nav__bar {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 150px;
    height: 3px;
    background: var(--signal);
    transform-origin: 0 50%;
  }

  .ss-top__controls {
    display: flex;
    align-items: stretch;
  }

  .ss-top__cell {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 16px;
    border-left: 1px solid var(--border);
    font-size: 12px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .ss-top__badge i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2f9e44;
  }

  .ss-top__cta {
    position: relative;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 18px;
    min-width: 196px;
    overflow: hidden;
    line-height: 1;
    background: var(--ink);
    color: var(--ink-text);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    isolation: isolate;
  }

  .ss-top__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--signal-fill);
    transform: translateY(101%);
    transition: transform 0.35s var(--wipe);
  }

  .ss-top__cta:hover::before,
  .ss-top__cta:focus-visible::before {
    transform: none;
  }

  .ss-top__cta:focus-visible {
    outline-color: var(--signal);
    outline-offset: -4px;
  }

  .ss-top__cta-text {
    flex: 1;
  }

  .ss-top__cta svg path,
  .ss-list svg path,
  .ss-ask__go svg path,
  .ss-btn svg path,
  .ss-probe__head svg path,
  .ss-world :global(.ss-site__x) path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ss-top__cta svg:first-child path {
    fill: currentColor;
    stroke: none;
  }

  .ss-top__cta-arrow {
    transition: transform 0.25s;
  }

  .ss-top__cta:hover .ss-top__cta-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 1100px) {
    .ss-nav__link,
    .ss-nav__bar {
      width: 118px;
    }

    .ss-top__badge {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .ss-top {
      grid-template-columns: minmax(0, 1fr) auto;
      height: auto;
    }

    .ss-top__brand {
      height: 56px;
      border-right: none;
    }

    .ss-top__cta {
      min-width: 0;
      min-height: 56px;
      padding: 0 16px;
    }

    .ss-top__cta-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .ss-nav {
      grid-column: 1 / -1;
      grid-row: 2;
      border-top: 1px solid var(--border);
    }

    .ss-nav__link {
      flex: 1;
      width: auto;
      min-width: 0;
      height: 52px;
    }

    .ss-nav__link:last-of-type {
      border-right: none;
    }

    .ss-nav__bar {
      width: 25%;
    }
  }

  /* ---------- Hero ---------- */
  .ss-hero {
    position: relative;
    display: grid;
    gap: 28px;
    padding: 28px var(--ss-gutter) 40px;
  }

  .ss-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 12px 0 8px;
  }

  .ss-meta {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .ss-world :global(.ss-kicker) {
    font-size: 12.5px;
    color: var(--text-secondary);
    white-space: pre;
  }

  .ss-title {
    max-width: 13ch;
    font-size: clamp(34px, 4.2vw, 56px);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.02;
    outline: none;
  }

  /* Headline words uncovered by ink blocks (styles.css .block-reveal). */
  .ss-br {
    position: relative;
    display: inline-block;
  }

  .ss-br__block {
    position: absolute;
    left: -0.03em;
    right: -0.03em;
    top: 0.1em;
    bottom: 0.02em;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* The ask bar (styles.css .ask). Decorative: the example types itself out. */
  .ss-ask {
    display: flex;
    align-items: stretch;
    width: 100%;
    max-width: 640px;
    height: 58px;
    margin-top: 6px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
  }

  .ss-ask__prompt {
    display: flex;
    align-items: center;
    padding: 0 4px 0 16px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--signal-text);
  }

  .ss-ask__field {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    padding: 0 12px 0 8px;
    overflow: hidden;
    font-size: 14px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .ss-ask__ghost {
    overflow: hidden;
    text-overflow: clip;
  }

  .ss-cursor--ghost {
    flex: none;
    width: 0.55em;
    background: var(--text-muted);
  }

  .ss-ask__go {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 20px;
    background: var(--ink);
    color: var(--ink-text);
    font-weight: 600;
    font-size: 14.5px;
  }

  /* Ruled rows (styles.css .example-list). */
  .ss-list {
    width: 100%;
    max-width: 640px;
    border-top: 1px solid var(--border);
  }

  .ss-list li {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 9px 10px;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .ss-list li:has(.ss-list__link) {
    padding: 0;
  }

  /* On the grid paper: --text-secondary, so the numbers clear 4.5:1 even where a grid line runs behind them. */
  .ss-list__n {
    flex: none;
    font-size: 11px;
    color: var(--text-secondary);
  }

  .ss-list__text {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    color: var(--text-primary);
    font-weight: 500;
  }

  .ss-list__label {
    min-width: 64px;
    font-size: 12.5px;
    font-weight: 400;
    color: var(--text-secondary);
  }

  .ss-list__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 44px;
    padding: 9px 10px;
    color: var(--text-secondary);
    text-decoration: none;
    isolation: isolate;
    transition: color 0.2s;
  }

  .ss-list__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--wipe);
  }

  .ss-list__link svg {
    flex: none;
    color: var(--text-muted);
    transition:
      transform 0.25s,
      color 0.2s;
  }

  .ss-list__link:hover,
  .ss-list__link:focus-visible,
  .ss-list__link:hover .ss-list__text,
  .ss-list__link:focus-visible .ss-list__text,
  .ss-list__link:hover .ss-list__label,
  .ss-list__link:focus-visible .ss-list__label {
    color: var(--ink-text);
  }

  .ss-list__link:hover::before,
  .ss-list__link:focus-visible::before {
    transform: none;
  }

  .ss-list__link:hover .ss-list__n,
  .ss-list__link:focus-visible .ss-list__n,
  .ss-list__link:hover svg,
  .ss-list__link:focus-visible svg {
    color: var(--signal-on-ink);
  }

  .ss-list__link:hover svg,
  .ss-list__link:focus-visible svg {
    transform: translate(2px, -2px);
  }

  .ss-demo {
    max-width: 60ch;
    font-size: 12.5px;
    color: var(--text-secondary);
  }

  .ss-demo .ss-mono {
    margin-right: 4px;
    font-size: 11.5px;
    color: var(--signal-text);
  }

  /* ---------- The opportunity map ---------- */
  .ss-world .ss-map {
    position: relative;
    min-height: 420px;
    overflow: hidden;
    padding: 0;
    background: var(--grid);
  }

  .ss-map__stage {
    position: absolute;
    inset: 0;
  }

  .ss-map__types {
    position: absolute;
    left: 12px;
    top: 12px;
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .ss-map__types span {
    padding: 5px 12px;
    border-radius: 7px;
  }

  .ss-map__types .is-on {
    background: var(--ink);
    color: var(--ink-text);
  }

  .ss-map__types small {
    margin-left: 5px;
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .ss-legend-card {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 11.5px;
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .ss-legend-card__title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ss-legend-card__note {
    color: var(--text-muted);
  }

  .ss-ramp {
    display: grid;
    grid-template-columns: repeat(5, 54px);
    gap: 3px;
    font-size: 10.5px;
  }

  .ss-ramp li {
    display: flex;
    flex-direction: column;
    gap: 3px;
    white-space: nowrap;
  }

  .ss-ramp i {
    display: block;
    height: 10px;
    border-radius: 2px;
    clip-path: polygon(6px 0, calc(100% - 6px) 0, 100% 50%, calc(100% - 6px) 100%, 6px 100%, 0 50%);
  }

  .ss-ramp .b0 {
    background: #ec8f8a;
  }

  .ss-ramp .b1 {
    background: #e2655f;
  }

  .ss-ramp .b2 {
    background: #d0433c;
  }

  .ss-ramp .b3 {
    background: #ac2c26;
  }

  .ss-ramp .b4 {
    background: #7e1d1a;
  }

  /* The model run card (styles.css .probe-card). */
  .ss-probe {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 300px;
    max-width: calc(100% - 24px);
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px 16px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.08);
  }

  .ss-probe__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-muted);
  }

  .ss-probe__kicker {
    font-size: 11.5px;
    white-space: pre;
  }

  .ss-probe__title {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .ss-probe__value {
    display: flex;
    flex-direction: column;
  }

  .ss-probe__value span {
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }

  .ss-probe__value small {
    font-size: 12px;
    color: var(--text-muted);
  }

  .ss-spark {
    position: relative;
    height: 64px;
  }

  .ss-spark svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ss-spark__band {
    fill: var(--text-primary);
    opacity: 0.08;
  }

  .ss-spark__line {
    fill: none;
    stroke: var(--text-primary);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .ss-spark__dot {
    position: absolute;
    right: -4px;
    width: 9px;
    height: 9px;
    margin-top: -4.5px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 2px var(--surface);
  }

  .ss-probe__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  .ss-probe__stats div {
    min-width: 0;
    padding: 7px 9px;
    border-radius: 10px;
    border: 1px solid var(--border);
  }

  .ss-probe__stats dt {
    font-size: 11px;
    color: var(--text-muted);
  }

  .ss-probe__stats dd {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .ss-probe__actions {
    display: flex;
    gap: 6px;
  }

  .ss-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    overflow: hidden;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    isolation: isolate;
  }

  .ss-btn--accent {
    flex: 1;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ink-text);
    font-weight: 600;
  }

  .ss-btn--ghost {
    border-color: transparent;
  }

  .ss-btn__wipe {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--signal-fill);
    transform: translateY(101%);
  }

  /* ---------- Decisions ---------- */
  .ss-dec {
    position: relative;
    padding: 40px var(--ss-gutter) 72px;
  }

  .ss-dec__title {
    margin-top: 10px;
    max-width: 16ch;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .ss-dec__list {
    display: grid;
    gap: 28px;
    margin-top: 24px;
  }

  /* A decision is a ruled cell (styles.css .cap): its ink fill rises from the bottom. */
  .ss-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
  }

  .ss-cell__fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: 50% 100%;
  }

  .ss-cell__top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
    font-size: 11px;
  }

  .ss-cell__n {
    color: var(--signal-text);
  }

  .ss-cell__code {
    color: var(--text-muted);
  }

  .ss-cell__title {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .ss-scene {
    margin-top: 12px;
  }

  .ss-scene__ranges {
    display: grid;
    gap: 12px;
  }

  .ss-scene__app :global(.browser) {
    --c-surface: #ffffff;
    --c-fg: #161616;
    --c-muted: #4a4a47;
  }

  /* The full-page capture is taller than the frame: the frame keeps its 16:10 and the page
     shows from the top (full mode scrolls it). */
  .ss-scene__app :global(.browser__screen) {
    min-height: 0;
  }

  /* Card heads shared by the chart and the ledger. */
  .ss-world :global(.ss-card__head) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .ss-world :global(.ss-card__title) {
    margin-top: 2px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ss-world :global(.ss-card__note) {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .ss-world :global(.ss-card__note strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* ---------- forecast.monthly() ---------- */
  .ss-world :global(.ss-chart) {
    padding: 18px 18px 12px;
  }

  .ss-world :global(.ss-seg) {
    display: inline-flex;
    flex: none;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .ss-world :global(.ss-seg span) {
    padding: 5px 12px;
    border-radius: 7px;
  }

  .ss-world :global(.ss-seg .is-on) {
    background: var(--ink);
    color: var(--ink-text);
  }

  .ss-world :global(.ss-legend) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 12px 0 6px;
    font-size: 12px;
    color: var(--text-secondary);
  }

  .ss-world :global(.ss-legend li) {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ss-world :global(.ss-legend path) {
    fill: none;
    stroke: var(--text-secondary);
    stroke-width: 1.75;
  }

  .ss-world :global(.ss-legend .is-on path) {
    stroke: var(--signal);
    stroke-width: 2.5;
  }

  .ss-world :global(.ss-plot) {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    grid-template-rows: minmax(140px, 1fr) 22px;
    height: 240px;
    padding-right: 6px;
  }

  .ss-world :global(.ss-plot__y) {
    position: relative;
    font-size: 11px;
    color: var(--text-muted);
  }

  .ss-world :global(.ss-plot__y span) {
    position: absolute;
    right: 8px;
    transform: translateY(-50%);
    font-variant-numeric: tabular-nums;
  }

  .ss-world :global(.ss-plot__area) {
    position: relative;
  }

  .ss-world :global(.ss-plot__area svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ss-world :global(.ss-plot__grid) {
    stroke: var(--grid);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .ss-world :global(.ss-plot__band) {
    fill: var(--signal);
    fill-opacity: 0.12;
  }

  .ss-world :global(.ss-plot__line) {
    fill: none;
    stroke: var(--text-secondary);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .ss-world :global(.ss-plot__line.is-on) {
    stroke: var(--signal);
    stroke-width: 2.5;
  }

  .ss-world :global(.ss-plot__dot) {
    position: absolute;
    left: 100%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--text-secondary);
    box-shadow: 0 0 0 2px var(--surface);
  }

  .ss-world :global(.ss-plot__dot.is-on) {
    background: var(--signal);
  }

  .ss-world :global(.ss-plot__x) {
    position: relative;
    grid-column: 2;
    font-size: 11px;
    color: var(--text-muted);
  }

  .ss-world :global(.ss-plot__x span) {
    position: absolute;
    top: 4px;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .ss-world :global(.ss-plot__x span:first-child) {
    transform: none;
  }

  /* ---------- Site cards ---------- */
  .ss-world :global(.ss-sites) {
    display: grid;
    gap: 8px;
  }

  .ss-world :global(.ss-site) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 11px 12px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .ss-world :global(.ss-site__meta) {
    display: flex;
    gap: 12px;
    font-size: 11px;
    line-height: 1.4;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .ss-world :global(.ss-site__meta span:last-child) {
    margin-left: auto;
  }

  .ss-world :global(.ss-site__main) {
    display: grid;
    grid-template-columns: auto minmax(40px, 1fr) auto;
    align-items: center;
    gap: 12px;
  }

  .ss-world :global(.ss-site__value) {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .ss-world :global(.ss-site__range) {
    position: relative;
    top: 6px;
    height: 12px;
    border-top: 1px dashed var(--border-strong);
  }

  .ss-world :global(.ss-site__ci) {
    position: absolute;
    top: -2.5px;
    height: 4px;
    border-radius: 2px;
    background: var(--text-primary);
    opacity: 0.8;
    transform-origin: 50% 50%;
  }

  .ss-world :global(.ss-site__dot) {
    position: absolute;
    top: -6px;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    border-radius: 50%;
    background: var(--text-primary);
    box-shadow: 0 0 0 2px var(--surface);
  }

  .ss-world :global(.ss-site__aux) {
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .ss-world :global(.ss-site__aux strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .ss-world :global(.ss-site__foot) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ss-world :global(.ss-site__name) {
    flex: 1;
    min-width: 0;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ss-world :global(.ss-site__x) {
    flex: none;
    color: var(--text-muted);
  }

  .ss-world :global(.ss-key) {
    display: inline-grid;
    place-items: center;
    min-width: 24px;
    height: 18px;
    padding: 0 4px;
    flex: none;
    border-radius: 4px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font: 600 10.5px/1 var(--mono);
    color: var(--text-primary);
  }

  .ss-world :global(.ss-key.is-selected) {
    background: var(--signal-fill);
    border-color: var(--signal-fill);
    color: #fff;
  }

  .ss-world :global(.ss-site.is-selected) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ink-text);
  }

  .ss-world :global(.ss-site.is-selected .ss-site__meta),
  .ss-world :global(.ss-site.is-selected .ss-site__aux),
  .ss-world :global(.ss-site.is-selected .ss-site__x) {
    color: var(--ink-muted);
  }

  .ss-world :global(.ss-site.is-selected .ss-site__aux strong) {
    color: var(--ink-text);
  }

  .ss-world :global(.ss-site.is-selected .ss-site__range) {
    border-top-color: var(--ink-muted);
  }

  .ss-world :global(.ss-site.is-selected .ss-site__ci) {
    background: var(--ink-text);
  }

  .ss-world :global(.ss-site.is-selected .ss-site__dot) {
    background: var(--signal);
    box-shadow: 0 0 0 2px var(--ink);
  }

  /* ---------- model.explain(site) ---------- */
  .ss-world :global(.ss-eq) {
    padding: 20px 20px 18px;
  }

  .ss-world :global(.ss-eq__title) {
    margin: 2px 0 4px;
    font-size: clamp(19px, 1.7vw, 24px);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .ss-world :global(.ss-explain) {
    display: grid;
