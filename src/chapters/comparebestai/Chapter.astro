---
/**
 * Compare Best AI, redesigned: the product as it would ship today, in the brand it already has
 * (navy, Signal Blue, Montserrat, with Inter for figures). No sidebar and no robot: a navy top bar
 * with a ⌘K search, then three screens, each with the decision it shows. The homepage, whose hero
 * is a composed stack: a navy Top pick review card with its score's breakdown, a glass Editor's
 * picks chip and a light Side by side card; the command palette, where one query finds tools, a
 * comparison and a sponsored deal; the compare page, whose diverging bars point at the winner of
 * each rated area; and the rankings, a podium and a list, with the deals in their own lane as
 * tear-off tickets. Scores, prices, counts and deals are the live site's (October 2026); every
 * tool shows its own icon. Each screen opens out of the thing that led to it (motion.ts, the morph).
 */
import '@fontsource-variable/montserrat';
import '@fontsource-variable/inter';
import ChapterSection from '../../components/ChapterSection.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { tools, type ToolId } from './tools';
import type { Chapter } from '../types';

interface Props {
  chapter: Chapter;
  index: number;
  next: string;
}
const { chapter, index, next } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const [site, compareLink] = chapter.links;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const total = String(chapter.decisions.length).padStart(2, '0');
// One decision per screen, in chapter.ts's order: the homepage, the compare page, the rankings.
const notes = chapter.decisions.map((d, i) => ({ n: String(i + 1).padStart(2, '0'), title: d.title }));

const nav = [
  { key: 'rated', label: 'Top rated' },
  { key: 'compare', label: 'Compare' },
  { key: 'deals', label: 'Deals' },
  { key: 'articles', label: 'Articles' },
] as const;

const CIRC = 2 * Math.PI * 44;
const dash = (score: number) => `stroke-dasharray:${((CIRC * score) / 10).toFixed(1)} 400`;
const mean = (xs: number[]) => Math.round((xs.reduce((s, x) => s + x, 0) / xs.length) * 10) / 10;

// The homepage (October 2026). The Top pick's score is the mean of its four rated areas.
const pickAreas = [
  { label: 'Features', v: 9.2 },
  { label: 'Output', v: 9.0 },
  { label: 'Ease of use', v: 8.6 },
  { label: 'Value', v: 8.4 },
];
const pickScore = mean(pickAreas.map((a) => a.v));
const pros = [
  { good: true, text: 'Deepest keyword data' },
  { good: true, text: 'Site audits built in' },
  { good: false, text: 'Priced for teams' },
];
const picks: ToolId[] = ['grammarly', 'notion', 'frase', 'pictory'];
const stats = [
  { value: '1,904', label: 'tools' },
  { value: '20', label: 'categories' },
  { value: 'Weekly', label: 'updates' },
] as const;

// The command palette: one query, three kinds of answer.
const found: { id: ToolId; cat: string; score: string }[] = [
  { id: 'grammarly', cat: 'Writing', score: '8.2' },
  { id: 'quillbot', cat: 'Writing', score: '7.0' },
  { id: 'frase', cat: 'SEO writing', score: '7.5' },
];

// The compare page (app/compare). Each overall score is the mean of its four rated areas.
const areas = [
  { label: 'Output quality', a: 8.4, b: 7.0 },
  { label: 'Ease of use', a: 9.0, b: 7.5 },
  { label: 'Value for money', a: 7.0, b: 7.5 },
  { label: 'Features & tools', a: 8.4, b: 6.0 },
] as const;
const versus = [
  { id: 'grammarly' as ToolId, brand: '#027e6f', by: 'Grammarly Inc.', score: mean(areas.map((r) => r.a)), price: ['Free', 'Pro $12/mo'], best: 'Grammar, spelling, style and tone' },
  { id: 'quillbot' as ToolId, brand: '#45c740', by: 'Learneo, Inc.', score: mean(areas.map((r) => r.b)), price: ['Free', 'From $4.17/mo'], best: 'Paraphrasing academic drafts' },
];
const [A, B] = versus.map((v) => tools[v.id].name);
const winner = versus[0].score >= versus[1].score ? A : B;
const leads = areas.filter((r) => (winner === A ? r.a > r.b : r.b > r.a)).length;
const value = areas.find((r) => r.label === 'Value for money')!;
const bestValue = value.a >= value.b ? A : B;

// The rankings: a podium for the top three, then the list. Equal scores are ordered by name.
const ranked: { id: ToolId; cat: string; score: number }[] = [
  { id: 'semrush', cat: 'Marketing', score: 8.8 },
  { id: 'elevenlabs', cat: 'Audio & Voice', score: 8.5 },
  { id: 'grammarly', cat: 'Writing', score: 8.2 },
  { id: 'fireflies', cat: 'Productivity', score: 7.8 },
  { id: 'notion', cat: 'Productivity', score: 7.8 },
];
const deals: { id: ToolId; cat: string; num: string; unit: string; line: string; code?: string }[] = [
  { id: 'xero', cat: 'Finance', num: '80%', unit: 'off', line: 'Any plan, first 6 months' },
  { id: 'beehiiv', cat: 'Newsletters', num: '20%', unit: 'off', line: 'New users, first 3 months' },
  { id: 'kavout', cat: 'Trading', num: '$5', unit: 'off', line: 'Your first payment', code: 'SARA5' },
];
---

<ChapterSection chapter={chapter} next={next} class="cb">
  <div class="cb-world">
    <svg class="cb-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="cb-arc" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#8be3ff"></stop>
          <stop offset="1" stop-color="#00a8e8"></stop>
        </linearGradient>
      </defs>
    </svg>
    <i class="cb-ground" aria-hidden="true" data-cb="ground"></i>
    <header class="cb-top" data-cb="top" data-clear>
      <img class="cb-brand" src={`${base}shots/comparebestai/logo.webp`} alt="Compare Best AI" width="320" height="140" decoding="async" />
      <span class="cb-nav" aria-hidden="true">
        <i class="cb-nav__dot" data-cb="nav-dot"></i>
        {
          nav.map((n) => (
            <span class="cb-nav__item" data-cb-nav={n.key}>
              {n.label}
            </span>
          ))
        }
      </span>
      <span class="cb-cmd" aria-hidden="true" data-cb="cmd">
        <Icon name="search" size={15} />
        Search 1,904 tools
        <kbd>⌘K</kbd>
      </span>
      <span class="cb-top__num" aria-hidden="true">{num}</span>
      <a class="cb-visit" href={site.href} target="_blank" rel="noopener noreferrer">
        Visit the site<span class="visually-hidden"> (opens in a new tab)</span>
        <Icon name="arrow-up-right" size={15} />
      </a>
    </header>

    <div class="cb-stage">
      <!-- 1. The homepage: the pitch on the left, a composed stack of the product on the right. -->
      <div class="cb-scene cb-home" data-cb="home" data-clear>
        <i class="cb-home__grid" aria-hidden="true" data-cb="home-grid"></i>
        <div class="cb-home__copy">
          <h2 class="cb-title" id={`${chapter.slug}-title`} tabindex="-1" data-focus>
            <span class="visually-hidden">{chapter.name}: </span>
            <span data-cb="title">Simple comparisons. <span class="cb-title__hi">Smarter choices.</span></span>
          </h2>
          <div class="cb-ctas" data-cb="hero-bit">
            <a class="cb-btn cb-btn--dark" href={compareLink.href} target="_blank" rel="noopener noreferrer">
              {compareLink.label}<span class="visually-hidden"> (opens in a new tab)</span>
              <Icon name="arrow-right" size={17} />
            </a>
          </div>
          <ul class="cb-stats" data-cb="hero-bit">
            {
              stats.map((s) => (
                <li>
                  <b>{s.value}</b>
                  <span>{s.label}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="cb-note" data-cb="note">
          <span class="cb-note__n" aria-hidden="true"><b>{notes[0].n}</b>&thinsp;/&thinsp;{total}</span>
          <h3 class="cb-note__title" data-cb="note-title">{notes[0].title}</h3>
        </div>

        <div
          class="cb-stack"
          role="img"
          aria-label={`Homepage. Top pick: Semrush, ${pickScore.toFixed(1)} out of 10 (${pickAreas.map((a) => `${a.label} ${a.v.toFixed(1)}`).join(", ")}), from $299 a month. Editor's picks. Side by side: ${A} ${versus[0].score.toFixed(1)}, ${B} ${versus[1].score.toFixed(1)}.`}
          data-cb="stack"
        >
          <i class="cb-stack__aura" data-cb="aura"></i>

          <!-- The Top pick, on navy glass: the one dark card, its score first. -->
          <div class="cb-hcard" data-cb="tile" data-shell="dark">
            <span class="cb-hcard__body" data-cb="tile-body">
              <span class="cb-hcard__label"><Icon name="award" size={14} /> Top pick · Marketing</span>
              <span class="cb-hcard__who">
                <Logo tool="semrush" size="lg" />
                <span>
                  <b>Semrush</b>
                  <small>SEO and competitor research</small>
                </span>
                <span class="cb-hcard__price">
                  <small>Pro plan</small>
                  <b>$299<span>/mo</span></b>
                </span>
              </span>
              <span class="cb-hcard__tags">
                <span>SEO</span>
                <span>PPC</span>
                <span>Content</span>
              </span>
              <span class="cb-hcard__score">
                <span class="cb-ring cb-ring--dark cb-ring--big">
                  <svg viewBox="0 0 100 100">
                    <circle class="cb-ring__track" cx="50" cy="50" r="44"></circle>
                    <circle class="cb-ring__arc" cx="50" cy="50" r="44" style={dash(pickScore)} data-cb="arc" data-score={pickScore}></circle>
                  </svg>
                  <!-- The score's arc: a live fill (a looping video) shaped as a gauge: cut to the ring and
                       to the score (--p), lit on its rim, shaded on its inner edge, with a bright leading tip. -->
                  <span class="cb-ring__fill" style={`--p:${pickScore / 10}`} data-cb="fill" data-score={pickScore} aria-hidden="true">
                    <video src={`${base}shots/comparebestai/gauge.mp4`} muted loop playsinline autoplay preload="auto"></video>
                    <i class="cb-ring__tip"></i>
                  </span>
                  <span class="cb-ring__num">
                    <b data-cb="num" data-score={pickScore}>{pickScore.toFixed(1)}</b><small>/10</small>
                  </span>
                </span>
                <span class="cb-break">
                  {
                    pickAreas.map((a) => (
                      <span class="cb-break__row">
                        <span>{a.label}</span>
                        <span class="cb-break__track">
                          <i style={`--v:${a.v / 10}`} data-cb="break-bar" />
                        </span>
                        <b>{a.v.toFixed(1)}</b>
                      </span>
                    ))
                  }
                </span>
              </span>
              <span class="cb-hcard__pros">
                {
                  pros.map((p) => (
                    <span class:list={{ 'is-con': !p.good }}>
                      <Icon name={p.good ? 'check' : 'minus'} size={14} stroke={2.5} />
                      {p.text}
                    </span>
                  ))
                }
              </span>
              <span class="cb-hcard__foot">
                <span class="cb-hcard__cta">Read review <Icon name="arrow-right" size={15} /></span>
              </span>
            </span>
          </div>

          <!-- Glass chip on the card's corner: the week's Editor's picks. -->
          <div class="cb-float" data-cb="tile" data-shell="glass">
            <span class="cb-float__body" data-cb="tile-body">
              <span class="cb-avs">
                {picks.map((id) => <Logo tool={id} size="sm" />)}
              </span>
              <span class="cb-float__txt">
                <b>Editor’s picks</b>
                <small>{tools[picks[0]].name}, {tools[picks[1]].name} +2</small>
              </span>
            </span>
          </div>

          <!-- A light card in front: the comparison the palette is about to open. -->
          <div class="cb-mini" data-cb="tile" data-shell="light">
            <span class="cb-mini__body" data-cb="tile-body">
              <span class="cb-mini__head">
                <span class="cb-mini__label"><Icon name="arrow-left-right" size={13} /> Side by side</span>
                <span class="cb-mini__tag">Writing</span>
              </span>
              {
                versus.map((t) => (
                  <span class:list={['cb-mini__row', { 'is-win': tools[t.id].name === winner }]}>
                    <Logo tool={t.id} size="sm" />
                    <b>{tools[t.id].name}</b>
                    <span class="cb-mini__track">
                      <i style={`--v:${t.score / 10}`} data-cb="mini-bar" />
                    </span>
                    <span class="cb-mini__score">{t.score.toFixed(1)}</span>
                  </span>
                ))
              }
            </span>
          </div>
        </div>
      </div>

      <!-- 2. The command palette, over the homepage. -->
      <div class="cb-k" aria-hidden="true" data-cb="k">
        <i class="cb-k__scrim" data-cb="scrim"></i>
        <div class="cb-k__box" data-cb="palette">
          <span class="cb-k__input">
            <Icon name="search" size={18} />
            <span class="cb-k__query">
              <span class="cb-k__typed" data-cb="typed">writing</span><i class="cb-k__caret"></i>
            </span>
            <kbd>esc</kbd>
          </span>
          <span class="cb-k__list" data-cb="k-list">
            <span class="cb-k__rows">
              <i class="cb-k__sel" data-cb="sel"></i>
              <span class="cb-k__group" data-cb="k-row">Tools</span>
              {
                found.map((t) => (
                  <span class="cb-k__row" data-cb="k-row">
                    <Logo tool={t.id} size="sm" />
                    <b>{tools[t.id].name}</b>
                    <small>{t.cat}</small>
                    <span class="cb-star">
                      <Icon name="star" size={11} />
                      {t.score}
                    </span>
                  </span>
                ))
              }
              <span class="cb-k__group" data-cb="k-row">Compare</span>
              <span class="cb-k__row" data-cb="k-row" data-cb-target>
                <span class="cb-k__pair">
                  <Logo tool="grammarly" size="sm" />
                  <Logo tool="quillbot" size="sm" />
                </span>
                <b>{A} vs {B}</b>
                <small>Side by side</small>
                <span class="cb-k__enter" data-cb="enter"><Icon name="corner-down-left" size={13} /></span>
              </span>
              <span class="cb-k__group" data-cb="k-row">Deals</span>
              <span class="cb-k__row" data-cb="k-row">
                <Logo tool="beehiiv" size="sm" />
                <b>Beehiiv · 20% off</b>
                <small>First 3 months</small>
                <span class="cb-sponsor">Sponsored</span>
              </span>
            </span>
          </span>
          <span class="cb-k__foot">
            <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
            <span><kbd>↵</kbd> Open</span>
            <span><kbd>esc</kbd> Close</span>
          </span>
        </div>
      </div>

      <!-- 3. The compare page: a split screen, one bar per rated area, each pointing at its winner. -->
      <div class="cb-scene cb-vs" data-cb="vs" data-clear>
        <div class="cb-note" data-cb="note">
          <span class="cb-note__n" aria-hidden="true"><b>{notes[1].n}</b>&thinsp;/&thinsp;{total}</span>
          <h3 class="cb-note__title" data-cb="note-title">{notes[1].title}</h3>
        </div>
        <!-- A designer's spec callout: a hairline from the decision's evidence to its token (motion.ts places it). -->
        <span class="cb-spec" data-cb="spec" aria-hidden="true">
          <i class="cb-spec__line"></i>
          <i class="cb-spec__run"></i>
          <i class="cb-spec__dot"></i>
          <span class="cb-spec__label"><b>Signal</b> #00B0F0 · winner only</span>
        </span>

        <div
          class="cb-duel"
          role="img"
          aria-label={`Comparison. ${A} scores ${versus[0].score.toFixed(1)} out of 10, ${B} ${versus[1].score.toFixed(1)}. ${areas.map((r) => `${r.label}: ${A} ${r.a.toFixed(1)}, ${B} ${r.b.toFixed(1)}`).join('. ')}. ${winner} leads ${leads} of ${areas.length} areas; best value, ${bestValue}.`}
          data-cb="duel"
        >
          <span class="cb-duel__cat" data-cb="duel-bit"><Icon name="pen-line" size={13} /> Writing assistants</span>
          <span class="cb-duel__head" data-cb="duel-bit">
            {
              versus.map((t, i) => (
                <span class:list={['cb-side', i === 0 ? 'cb-side--a' : 'cb-side--b', { 'is-win': tools[t.id].name === winner }]} style={`--brand:${t.brand}`} data-cb="side">
                  <Logo tool={t.id} size="lg" />
                  <span class="cb-side__who">
                    <b>{tools[t.id].name}</b>
                    <small>by {t.by}</small>
                  </span>
                  <span class="cb-ring">
                    <svg viewBox="0 0 100 100">
                      <circle class="cb-ring__track" cx="50" cy="50" r="44" />
                      <circle class="cb-ring__arc" cx="50" cy="50" r="44" style={dash(t.score)} data-cb="arc" data-score={t.score} />
                    </svg>
                    {tools[t.id].name === winner && (
                      <span class="cb-ring__fill" style={`--p:${t.score / 10}`} data-cb="fill" data-score={t.score} aria-hidden="true">
                        <video src={`${base}shots/comparebestai/gauge.mp4`} muted loop playsinline autoplay preload="auto" />
                        <i class="cb-ring__tip" />
                      </span>
                    )}
                    <span class="cb-ring__num">
                      <b data-cb="num" data-score={t.score}>
                        {t.score.toFixed(1)}
                      </b>
                      <small>/10</small>
                    </span>
                    {tools[t.id].name === winner && (
                      <span class="cb-win" data-cb="crown">
                        <Icon name="award" size={11} /> Winner
                      </span>
                    )}
                  </span>
                </span>
              ))
            }
            <span class="cb-duel__x" data-cb="x">vs</span>
          </span>

          <span class="cb-duel__legend" data-cb="duel-bit">
            <span><i></i>{A}</span>
            <span>{B}<i></i></span>
          </span>

          <span class="cb-duel__chart" data-cb="duel-bit">
            {
              areas.map((r) => {
                const state = r.a > r.b ? 'a' : r.b > r.a ? 'b' : 'tie';
                return (
                  <span class:list={['cb-area', `cb-area--${state}`]} data-cb="area">
                    <b class="cb-area__va">{r.a.toFixed(1)}</b>
                    <span class="cb-area__track cb-area__track--a">
                      <i style={`--v:${r.a / 10}`} data-cb="bar" />
                    </span>
                    <span class="cb-area__label">
                      {r.label}
                      <small>{state === 'tie' ? 'Tie' : state === 'a' ? `← +${(r.a - r.b).toFixed(1)}` : `+${(r.b - r.a).toFixed(1)} →`}</small>
                    </span>
                    <span class="cb-area__track cb-area__track--b">
                      <i style={`--v:${r.b / 10}`} data-cb="bar" />
                    </span>
                    <b class="cb-area__vb">{r.b.toFixed(1)}</b>
                  </span>
                );
              })
            }
          </span>

          <span class="cb-duel__foot" data-cb="duel-bit">
            {
              versus.map((t) => (
                <span class="cb-plan" data-cb="plan">
                  <small>Best for</small>
                  <b>{t.best}</b>
                  <span class="cb-plan__chips">
                    <span class="cb-chip cb-chip--free">{t.price[0]}</span>
                    <span class="cb-chip">{t.price[1]}</span>
                  </span>
                </span>
              ))
            }
          </span>
        </div>

        <p class="cb-verdict" aria-hidden="true" data-cb="verdict">
          <span class="cb-verdict__k">Verdict</span>
          <span><b>{winner}</b> leads {leads} of {areas.length} areas</span>
          <span class="cb-verdict__alt">Best value <b>{bestValue}</b></span>
        </p>
      </div>

      <!-- 4. The rankings, a podium and a list; the deals beside them, as tickets in a lane of their own. -->
      <div class="cb-scene cb-lanes" data-cb="lanes" data-clear>
        <div class="cb-note" data-cb="note">
          <span class="cb-note__n" aria-hidden="true"><b>{notes[2].n}</b>&thinsp;/&thinsp;{total}</span>
          <h3 class="cb-note__title" data-cb="note-title">{notes[2].title}</h3>
        </div>
        <!-- A designer's spec callout: a hairline from the decision's evidence to its token (motion.ts places it). -->
        <span class="cb-spec" data-cb="spec" aria-hidden="true">
          <i class="cb-spec__line"></i>
          <i class="cb-spec__run"></i>
          <i class="cb-spec__dot"></i>
          <span class="cb-spec__label"><b>Stub</b> 2px dashed · tear-off</span>
        </span>

        <div class="cb-lanes__grid">
          <div
            class="cb-rank"
            role="img"
            aria-label={`Top rated, by editorial score: ${ranked.map((t, i) => `${i + 1}. ${tools[t.id].name}, ${t.score.toFixed(1)}`).join('; ')}.`}
            data-cb="rank"
          >
            <span class="cb-lane__head" data-cb="rank-bit">
              <b>Top rated</b>
              <span class="cb-seg">
                <span class="is-on">All</span>
                <span>Writing</span>
                <span>Marketing</span>
              </span>
            </span>
            <ol class="cb-podium">
              {
                ranked.slice(0, 3).map((t, i) => (
                  <li class:list={['cb-pod', `cb-pod--${i + 1}`]} data-cb="pod">
                    <span class="cb-pod__n">{i + 1}</span>
                    <Logo tool={t.id} size="lg" />
                    <span class="cb-pod__score">
                      <Icon name="star" size={15} />
                      {t.score.toFixed(1)}
                    </span>
                    <b>{tools[t.id].name}</b>
                    <small>{t.cat}</small>
                  </li>
                ))
              }
            </ol>
            <ol class="cb-rank__list" start="4">
              {
                ranked.slice(3).map((t, i) => (
                  <li class="cb-rank__row" data-cb="rank-row">
                    <span class="cb-rank__n">{i + 4}</span>
                    <Logo tool={t.id} />
                    <span class="cb-who">
                      <b>{tools[t.id].name}</b>
                      <small>{t.cat}</small>
                    </span>
                    <span class="cb-rank__score">
                      <Icon name="star" size={14} />
                      {t.score.toFixed(1)}
                    </span>
                  </li>
                ))
              }
            </ol>
            <span class="cb-rank__foot" data-cb="rank-bit">
              See all 1,904 tools
              <Icon name="chevron-right" size={15} />
            </span>
          </div>

          <div
            class="cb-deals"
            role="img"
            aria-label={`Deals, as sponsored tickets: ${deals.map((d) => `${tools[d.id].name}, ${d.num} ${d.unit}`).join('; ')}.`}
            data-cb="deals"
          >
            <span class="cb-lane__head cb-lane__head--dark">
              <b>Deals</b>
              <span class="cb-sponsor cb-sponsor--dark">Sponsored</span>
            </span>
            <span class="cb-tickets">
              {
                deals.map((d) => (
                  <span class="cb-ticket" data-cb="ticket">
                    <span class="cb-ticket__main">
                      <span class="cb-ticket__who">
