  .cb-hcard__who small {
    overflow: hidden;
    color: rgb(255 255 255 / 0.64);
    font-size: 13.5px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cb-hcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cb-hcard__tags span {
    padding: 4px 11px;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    color: rgb(255 255 255 / 0.82);
    font-size: 12px;
    font-weight: 600;
  }

  /* The score, then where it comes from: a glass panel inside the card. */
  .cb-hcard__score {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 2.2vw, 30px);
    padding: clamp(14px, 2vh, 20px) clamp(14px, 1.8vw, 22px);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 20px;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0.02));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
  }

  .cb-ring--big {
    width: clamp(108px, 15.5vh, 144px);
  }

  .cb-ring--big .cb-ring__num b {
    font-size: clamp(30px, 4.4vh, 42px);
  }

  .cb-break {
    display: grid;
    gap: clamp(8px, 1.4vh, 12px);
    min-width: 0;
  }

  .cb-break__row {
    display: grid;
    grid-template-columns: minmax(0, 6.6em) minmax(0, 1fr) 2.1em;
    align-items: center;
    gap: 10px;
    color: rgb(255 255 255 / 0.72);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .cb-break__track {
    height: 6px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.1);
  }

  .cb-break__track i {
    display: block;
    width: calc(var(--v) * 100%);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #5fd4ff, var(--signal));
    transform-origin: 0 50%;
  }

  .cb-break__row b {
    color: #fff;
    font: 700 13px/1 var(--font-cb-data);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .cb-hcard__pros {
    display: grid;
    gap: 8px;
    padding: 0 4px;
  }

  .cb-hcard__pros span {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgb(255 255 255 / 0.84);
    font-size: 13.5px;
    font-weight: 600;
  }

  .cb-hcard__pros :global(.cb-icon) {
    flex: none;
    padding: 3px;
    border-radius: 50%;
    background: rgb(0 176 240 / 0.16);
    color: var(--signal);
    box-sizing: content-box;
  }

  .cb-hcard__pros .is-con {
    color: rgb(255 255 255 / 0.62);
  }

  .cb-hcard__pros .is-con :global(.cb-icon) {
    background: rgb(255 255 255 / 0.08);
    color: rgb(255 255 255 / 0.62);
  }

  .cb-hcard__foot {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 14px;
    margin-top: auto;
  }

  .cb-hcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px 0 16px;
    border-radius: 12px;
    background: linear-gradient(180deg, #2ec0f5, var(--signal));
    color: var(--navy);
    font-size: 13.5px;
    font-weight: 700;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      0 6px 16px -8px rgb(0 0 0 / 0.5);
  }

  /* Glass chip: frosted white over the navy card's corner. */
  .cb-float {
    position: absolute;
    top: 0;
    right: 14px;
    z-index: 2;
    padding: 9px 16px 9px 9px;
    border: 1px solid rgb(255 255 255 / 0.8);
    border-radius: 18px;
    background: rgb(255 255 255 / 0.74);
    box-shadow: var(--shadow-float);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .cb-float__body {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cb-avs {
    display: flex;
  }

  /* Stacked icons: each sits over the next, so the first (the one named first) stays whole. */
  .cb-avs :global(.cb-logo + .cb-logo),
  .cb-k__pair :global(.cb-logo + .cb-logo) {
    margin-left: -8px;
  }

  .cb-avs :global(.cb-logo),
  .cb-k__pair :global(.cb-logo) {
    box-shadow: 0 0 0 2px #fff;
  }

  .cb-avs :global(.cb-logo:nth-child(1)),
  .cb-k__pair :global(.cb-logo:nth-child(1)) {
    z-index: 4;
  }

  .cb-avs :global(.cb-logo:nth-child(2)) {
    z-index: 3;
  }

  .cb-avs :global(.cb-logo:nth-child(3)) {
    z-index: 2;
  }

  /* On navy, an icon's edge is a light hairline. */
  .cb-hcard :global(.cb-logo::after) {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  .cb-float__txt {
    display: grid;
    line-height: 1.2;
    white-space: nowrap;
  }

  .cb-float__txt b {
    font-size: 13.5px;
    font-weight: 700;
  }

  .cb-float__txt small {
    color: #3d4b60;
    font-size: 11.5px;
  }

  /* Light card in front of the navy one, with a hairline that catches the Signal light. */
  .cb-mini {
    position: relative;
    z-index: 2;
    width: min(330px, 88%);
    margin: -34px 0 0 14px;
    padding: 16px 18px 18px;
    border: 1px solid transparent;
    border-radius: 20px;
    background:
      linear-gradient(#fff, #fff) padding-box,
      linear-gradient(140deg, rgb(0 176 240 / 0.55), var(--edge) 45%) border-box;
    box-shadow: var(--shadow-float);
  }

  .cb-mini__body {
    display: grid;
    gap: 12px;
  }

  .cb-mini__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .cb-mini__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cb-mini__label :global(.cb-icon) {
    color: var(--signal-text);
  }

  .cb-mini__tag {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--signal-soft);
    color: var(--signal-text);
    font-size: 11.5px;
    font-weight: 700;
  }

  .cb-mini__row {
    display: grid;
    grid-template-columns: auto minmax(0, 5.6em) minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
  }

  .cb-mini__row b {
    overflow: hidden;
    font-size: 13.5px;
    font-weight: 700;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cb-mini__track {
    height: 8px;
    border-radius: 99px;
    background: #f1f5fa;
  }

  .cb-mini__track i {
    display: block;
    width: calc(var(--v) * 100%);
    height: 100%;
    border-radius: inherit;
    background: var(--lose);
    transform-origin: 0 50%;
  }

  .cb-mini__row.is-win .cb-mini__track i {
    background: linear-gradient(90deg, #5fd4ff, var(--signal));
  }

  .cb-mini__score {
    font: 700 14px/1 var(--font-cb-data);
    font-variant-numeric: tabular-nums;
  }

  /* Unpinned, the light card overlaps the navy one's foot: the foot keeps clear of it. */
  :global(html:not(.mode-full)) .cb-hcard {
    padding-bottom: 58px;
  }

  /* Narrow stacks: the breakdown drops under the ring. */
  @container (max-width: 420px) {
    .cb-hcard__score {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }

    .cb-hcard__who .cb-hcard__price small {
      display: none;
    }

    .cb-hcard__who > span:nth-child(2) small {
      white-space: normal;
    }

    .cb-hcard__who .cb-hcard__price b {
      font-size: 18px;
    }

    .cb-break {
      width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .cb-home {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(32px, 4vw, 64px);
      align-items: center;
    }

    /* Without the pin (reduced motion), the decision heads its screen, as notes 02 and 03 do, and
       the screens leave the rail room to name the chapter, as they do pinned. */
    :global(html:not(.mode-full)) .cb-home .cb-note {
      grid-column: 1 / -1;
      order: -1;
    }

    :global(html:not(.mode-full)) .cb-scene,
    :global(html:not(.mode-full)) .cb-k {
      padding-right: calc(var(--rail) + clamp(40px, 9vw, 124px));
    }
  }

  /* ---------- 2. Command palette ---------- */
  .cb-k {
    position: relative;
    padding: 0 var(--cb-gutter) clamp(48px, 8vw, 88px);
  }

  .cb-k__scrim {
    display: none;
  }

  .cb-k__box {
    display: grid;
    width: min(100%, 640px);
    margin: 0 auto;
    overflow: hidden;
    border: 1px solid var(--edge);
    border-radius: 18px;
    background: #fff;
    box-shadow:
      0 1px 2px rgb(10 16 32 / 0.05),
      0 32px 64px -24px rgb(10 16 32 / 0.45);
  }

  .cb-k__input {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
    padding: 0 18px;
    border-bottom: 1px solid var(--edge);
    color: var(--muted);
  }

  .cb-k__query {
    display: inline-flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    color: var(--navy);
    font-size: 18px;
    font-weight: 500;
  }

  .cb-k__typed {
    white-space: pre;
  }

  .cb-k__caret {
    flex: none;
    width: 2px;
    height: 22px;
    margin-left: 2px;
    background: var(--signal);
    animation: cb-blink 1s steps(1) infinite;
  }

  @keyframes cb-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-k__caret {
      animation: none;
    }
  }

  /* The list clips the results so the box can grow with them. */
  .cb-k__list {
    display: block;
    overflow: hidden;
  }

  .cb-k__rows {
    position: relative;
    display: grid;
    padding: 6px 8px 8px;
  }

  .cb-k__sel {
    position: absolute;
    top: 0;
    left: 8px;
    right: 8px;
    height: 44px;
    border-radius: 10px;
    background: var(--signal-soft);
    box-shadow: inset 0 0 0 1px rgb(0 176 240 / 0.35);
    opacity: 0;
  }

  .cb-k__sel::before {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 0;
    width: 3px;
    border-radius: 0 3px 3px 0;
    background: var(--signal);
  }

  .cb-k__group {
    position: relative;
    padding: 10px 10px 4px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cb-k__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    padding: 0 10px 0 12px;
    font-size: 14px;
  }

  .cb-k__row b {
    overflow: hidden;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cb-k__row small {
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .cb-k__row small {
      display: none;
    }
  }

  .cb-k__pair {
    display: flex;
    flex: none;
  }

  .cb-k__enter {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-left: auto;
    border-radius: 7px;
    background: var(--signal);
    color: var(--navy);
  }

  .cb-k__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    padding: 10px 18px;
    border-top: 1px solid var(--edge);
    background: var(--page);
    color: var(--muted);
    font-size: 12px;
  }

  .cb-k__foot > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .cb-k__foot > span:last-child {
    margin-left: auto;
  }

  .cb-k__foot kbd {
    min-width: 20px;
    height: 20px;
  }

  /* ---------- 3. Compare ---------- */
  .cb-vs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    padding-top: 0;
  }

  .cb-duel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(18px, 2.8vh, 28px);
    padding: clamp(24px, 3vw, 36px) clamp(20px, 3vw, 36px) clamp(20px, 3vw, 36px);
    border: 1px solid var(--edge);
    border-radius: 26px;
    background: linear-gradient(180deg, #fff 70%, #fbfcfe);
    box-shadow: var(--shadow-2);
  }

  /* The page's category, as a tab on the card's top edge. */
  .cb-duel__cat {
    position: absolute;
    top: 0;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--edge);
    border-radius: 999px;
    background: #fff;
    color: var(--body);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    transform: translate(-50%, -50%);
    box-shadow: var(--shadow-1);
  }

  .cb-duel__cat :global(.cb-icon) {
    color: var(--signal-text);
  }

  .cb-duel__head {
    position: relative;
    display: grid;
    gap: 18px;
  }

  .cb-side {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  /* Each tool's icon sits on a soft pool of its own colour. */
  .cb-side :global(.cb-logo) {
    box-shadow:
      0 1px 2px rgb(10 16 32 / 0.06),
      0 14px 28px -12px var(--brand);
  }

  .cb-side__who {
    display: grid;
    justify-items: start;
    gap: 2px;
    min-width: 0;
    margin-right: auto;
  }

  /* The score is the largest thing on the card: names step down to it. */
  .cb-side .cb-ring {
    width: 116px;
  }

  .cb-side .cb-ring__num b {
    font-size: 38px;
  }

  .cb-side__who b {
    max-width: 100%;
    overflow: hidden;
    font-size: clamp(20px, 1.7vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .cb-side__who small {
    color: var(--muted);
    font-size: 13px;
  }

  .cb-side:not(.is-win) .cb-ring__arc {
    stroke: #a6b6cb;
  }

  /* The winner's badge hangs off its ring, so both names keep one baseline. */
  .cb-win {
    position: absolute;
    left: 50%;
    bottom: -9px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px 3px 8px;
    border-radius: 999px;
    background: var(--navy);
    color: #fff;
    font-size: 11.5px;
    font-weight: 700;
    white-space: nowrap;
    transform: translateX(-50%);
    box-shadow: 0 0 0 3px #fff;
  }

  .cb-win :global(.cb-icon) {
    color: var(--signal);
  }

  .cb-duel__x {
    display: none;
  }

  /* Narrow screens stack the sides, so the chart says which side is which. */
  .cb-duel__legend {
    display: flex;
    justify-content: space-between;
    color: var(--body);
    font-size: 12px;
    font-weight: 700;
  }

  .cb-duel__legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .cb-duel__legend i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
  }

  .cb-duel__legend span:last-child i {
    background: #a6b6cb;
  }

  .cb-duel__chart {
    display: grid;
  }

  /* One rated area: A's bar grows left from the centre, B's grows right. */
  .cb-area {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) minmax(0, 1fr) 34px;
    grid-template-areas:
      'label label label label'
      'va ta tb vb';
    align-items: center;
    column-gap: 10px;
    row-gap: 6px;
    padding: 10px 0;
    border-top: 1px solid var(--hair);
  }

  .cb-area__va {
    grid-area: va;
  }

  .cb-area__vb {
    grid-area: vb;
    text-align: right;
  }

  .cb-area__va,
  .cb-area__vb {
    color: var(--muted);
    font: 700 15px/1 var(--font-cb-data);
    font-variant-numeric: tabular-nums;
  }

  .cb-area__track {
    height: 12px;
    border-radius: 99px;
    background: #f1f5fa;
  }

  .cb-area__track--a {
    grid-area: ta;
    display: flex;
    justify-content: flex-end;
  }

  .cb-area__track--b {
    grid-area: tb;
  }

  .cb-area__track i {
    display: block;
    width: calc(var(--v) * 100%);
    height: 100%;
    border-radius: inherit;
    background: var(--lose);
  }

  .cb-area__track--a i {
    transform-origin: 100% 50%;
  }

  .cb-area__track--b i {
    transform-origin: 0 50%;
  }

  .cb-area__label {
    grid-area: label;
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
  }

  .cb-area__label small {
    color: var(--muted);
    font-size: 12.5px;
    font-weight: 700;
  }

  /* The winner's bar is lit, light at the centre line; the other side and a tie stay neutral. */
  .cb-area--a .cb-area__track--a i {
    background: linear-gradient(270deg, #5fd4ff, var(--signal));
  }

  .cb-area--b .cb-area__track--b i {
    background: linear-gradient(90deg, #5fd4ff, var(--signal));
  }

  .cb-area--a .cb-area__va,
  .cb-area--b .cb-area__vb {
    color: var(--navy);
  }

  .cb-area--a .cb-area__label small,
  .cb-area--b .cb-area__label small {
    color: var(--signal-text);
  }

  .cb-duel__foot {
    display: grid;
    gap: 12px;
  }

  .cb-plan {
    display: grid;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--hair);
    border-radius: 16px;
    background: var(--page);
  }

  .cb-plan small {
    color: var(--signal-text);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cb-plan b {
    font-size: 14px;
    font-weight: 600;
  }

  .cb-plan__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cb-verdict {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin: 0;
    padding: 14px 20px;
    border-radius: 18px;
    background: var(--navy-glass);
    color: rgb(255 255 255 / 0.78);
    font-size: 14px;
    box-shadow: var(--shadow-navy);
  }

  .cb-verdict b {
    color: #fff;
    font-weight: 700;
  }

  .cb-verdict__k {
    padding: 4px 9px;
    border-radius: 999px;
    background: rgb(0 176 240 / 0.14);
    color: var(--signal);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cb-verdict__alt {
    margin-left: auto;
  }

  @media (min-width: 720px) {
    .cb-duel__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 80px;
    }

    .cb-side--b {
      flex-direction: row-reverse;
      text-align: right;
    }

    .cb-side--b .cb-side__who {
      justify-items: end;
      margin-right: 0;
      margin-left: auto;
    }

    .cb-duel__x {
      position: absolute;
      top: 50%;
      left: 50%;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin: -22px 0 0 -22px;
      border-radius: 50%;
      background: linear-gradient(180deg, #1a2540, var(--navy));
      color: #fff;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      box-shadow:
        0 0 0 6px #fff,
        0 10px 24px -8px rgb(10 16 32 / 0.6);
    }

    .cb-duel__legend {
      display: none;
    }

    .cb-area {
      grid-template-columns: 40px minmax(0, 1fr) 176px minmax(0, 1fr) 40px;
      grid-template-areas: 'va ta label tb vb';
      padding: 11px 0;
    }

    .cb-area__label {
      flex-direction: column;
      align-items: center;
      gap: 1px;
      line-height: 1.3;
    }

    .cb-duel__foot {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 80px;
    }

    .cb-duel__foot .cb-plan:last-child {
      justify-items: end;
      text-align: right;
    }
  }

  /* Side by side but not yet wide: smaller icons and rings leave the names their room. */
  @media (min-width: 720px) and (max-width: 999px) {
    .cb-side :global(.cb-logo) {
