---
/**
 * A tool's icon on a white app-icon tile, the way the directory lists tools. Decorative: the
 * tool's name always sits beside it. Size comes from --s, which a context may override.
 */
import { tools, type Tool, type ToolId } from './tools';

interface Props {
  tool: ToolId;
  size?: 'sm' | 'md' | 'lg';
}
const { tool, size = 'md' } = Astro.props;
const t: Tool = tools[tool];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const px = { sm: 28, md: 36, lg: 56 }[size];
---

<span class:list={['cb-logo', `cb-logo--${size}`]} style={`--inset:${t.inset};--zoom:${t.zoom ?? 1}`} aria-hidden="true">
  <img src={`${base}shots/comparebestai/logos/${t.file}`} alt="" width={px} height={px} loading="eager" fetchpriority="low" decoding="async" />
</span>

<style>
  .cb-logo {
    --s: 36px;
    position: relative;
    display: block;
    flex: none;
    width: var(--s);
    height: var(--s);
    overflow: hidden;
    border-radius: calc(var(--s) * 0.28);
    background: #fff;
  }

  /* The hairline sits over the icon, so icons with their own ground keep a crisp edge too. */
  .cb-logo::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px rgb(10 16 32 / 0.08),
      inset 0 -1px 0 rgb(10 16 32 / 0.04);
    pointer-events: none;
  }

  .cb-logo img {
    display: block;
    width: 100%;
    height: 100%;
    padding: calc(var(--s) * var(--inset));
    object-fit: contain;
    transform: scale(var(--zoom));
  }

  .cb-logo--sm {
    --s: 28px;
  }

  .cb-logo--lg {
    --s: 56px;
    box-shadow: 0 1px 2px rgb(10 16 32 / 0.06), 0 8px 20px -10px rgb(10 16 32 / 0.25);
  }
</style>
