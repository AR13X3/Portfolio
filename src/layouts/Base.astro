---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist';
// The shell's two faces, preloaded so the loader and the intro's name paint in them at once.
// Imported as URLs so they are the very files the @font-face rules above point at (one request each).
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name}, ${site.role}, ${site.location}`, description = site.description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site);
// Bump ?v when og.png changes: link previews cache the image by its URL.
const ogImage = new URL(`${base}og.png?v=2`, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f3f4f5" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // Before first paint: does this visit get the gate (the loader, then the choice of intro), or
      // go straight in? Straight in for a link to a section, a reload or a return through history
      // partway down the page, and the review switches ?route=fan|machine and ?debug. ?loader always
      // shows the gate. Nothing about the choice is stored. Without JavaScript none of this runs:
      // no gate, and the Fan reads as a plain page.
      (function () {
        var d = document.documentElement;
        var q = new URLSearchParams(location.search);
        var route = q.get('route');
        var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var saved = 0;
        try {
          saved = Number(sessionStorage.getItem('portfolio:scroll')) || 0;
        } catch (e) {}
        var hash = decodeURIComponent(location.hash.slice(1));
        var deep = !!hash && hash !== 'top' && hash !== 'main';
        var restoring = !!nav && (nav.type === 'reload' || nav.type === 'back_forward') && saved > innerHeight * 0.25;
        var skip = !q.has('loader') && (route === 'fan' || route === 'machine' || q.has('debug') || deep || restoring);
        d.setAttribute('data-boot', skip ? 'skip' : 'load');
        // The gate locks the scroll and keeps the page out of layout until the choice shows.
        if (!skip) d.classList.add('boot-lock', 'boot-hide');
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        // If scripts/boot.ts never starts (blocked, too old a browser), show the plain page.
        setTimeout(function () {
          if (!d.classList.contains('boot-live')) d.classList.add('boot-late');
        }, 10000);
      })();
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}. Six products laid out on a bench, ready to set off a chain reaction.`} />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.name,
      jobTitle: site.role,
      email: `mailto:${site.email}`,
      sameAs: [site.links.github, site.links.linkedin],
      url: canonical.toString(),
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main" data-skip-link><span class="skip-link__page">Skip to content</span><span class="skip-link__gate">Skip the intro</span></a>
    <slot />
  </body>
</html>
