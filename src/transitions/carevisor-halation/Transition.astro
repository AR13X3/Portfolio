---
/**
 * CareVisor → Halation. The lights go down on CareVisor's bright page until the room is Halation's
 * near-black. Then a hairline of light opens down the middle, like light under a door, and the
 * two halves of the dark part to let Coral Reeds' frosted glow fill the window. On phones it is
 * a dark band that dims the page; Halation's canvas then holds mid-screen as its frost wipes away.
 */
interface Props {
  from: string;
  to: string;
}
---

<div class="cxh">
  <!-- Full mode: the room darkens from its corners first. -->
  <i class="cxh__vig" data-cxh="vig"></i>
  <div class="cxh__dim" data-cxh="dim">
    <i class="cxh__door cxh__door--l" data-cxh="door"><b data-cxh="spill"></b></i>
    <i class="cxh__door cxh__door--r" data-cxh="door"><b data-cxh="spill"></b></i>
  </div>
  <i class="cxh__seam" data-cxh="seam"></i>
</div>

<style>
  .cxh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Halation's ground (#08080a), as the light falls off toward the edges of the window. */
  .cxh__vig {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 75% 70% at 50% 50%, rgb(8 8 10 / 0) 30%, rgb(8 8 10 / 0.85) 100%);
    opacity: 0;
  }

  /* The doors fade as one (no seam where they overlap), then part. */
  .cxh__dim {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .cxh__door {
    position: absolute;
    top: 0;
    bottom: 0;
    /* A hair past the middle, so the two overlap and no line shows before they open. */
    width: calc(50% + 1px);
    background: #08080a;
  }
  .cxh__door--l {
    left: 0;
  }
  .cxh__door--r {
    right: 0;
  }

  /* Coral light spilling onto each door's inner edge once the crack opens. */
  .cxh__door b {
    position: absolute;
    top: 0;
    bottom: 0;
    width: min(32vw, 420px);
    opacity: 0;
  }
  .cxh__door--l b {
    right: 0;
    background: linear-gradient(90deg, rgb(255 132 102 / 0), rgb(255 132 102 / 0.16));
  }
  .cxh__door--r b {
    left: 0;
    background: linear-gradient(270deg, rgb(255 132 102 / 0), rgb(255 132 102 / 0.16));
  }

  /* The hairline: Coral Reeds' peach, glowing. */
  .cxh__seam {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: #ffd0b4;
    box-shadow:
      0 0 14px 3px rgb(255 150 112 / 0.6),
      0 0 70px 18px rgb(255 104 88 / 0.22);
    opacity: 0;
  }

  /* Lite: the transition is a short band in the page. The lights go down across it, never to black
     (--cxh-dim), and stay at that level into the top of Halation's world (Chapter.astro), where they
     come back up: Halation's canvas rises straight out of the dim while the ground turns to coral. */
  :global(html.mode-lite .chapter__transition:has(> .cxh)) {
    height: 40vh;
  }
  :global(html.mode-lite) .cxh__vig,
  :global(html.mode-lite) .cxh__seam {
    display: none;
  }
  :global(html.mode-lite) .cxh__dim {
    opacity: 0.78;
    mask-image: linear-gradient(180deg, transparent, #000);
  }
</style>
