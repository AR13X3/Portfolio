---
/**
 * CareVisor → Halation. CareVisor's blue (its accordion cards and every action on the site)
 * drops over the page in columns, left to right. Under it the ground turns to Halation's frosted
 * Coral Reeds. The columns catch the light like flutes of reeded glass, then narrow away to the
 * right, the direction Halation's own frost wipes, uncovering the canvas.
 */
interface Props {
  from: string;
  to: string;
}
const COLUMNS = 16;
---

<div class="cxh">
  {
    Array.from({ length: COLUMNS }, () => (
      <i class="cxh__col" data-cxh="col">
        <b data-cxh="sheen" />
      </i>
    ))
  }
</div>

<style>
  .cxh {
    position: absolute;
    inset: 0;
    display: flex;
    overflow: hidden;
    pointer-events: none;
  }

  /* CareVisor's blue, deepening down the column as its cards do (from #0052CC to #0A3F9E). */
  .cxh__col {
    position: relative;
    flex: 1;
    /* A hair wider than its slot, so neighbours overlap and no seam shows through. */
    margin-right: -1px;
    background: linear-gradient(180deg, #0052cc, #0a3f9e);
    transform: scaleY(0);
    transform-origin: 50% 0;
  }

  /* A flute's highlight: light gathers off-centre, as through Halation's reeded glass. */
  .cxh__col b {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(255 255 255 / 0) 0%, rgb(255 255 255 / 0.1) 34%, rgb(255 255 255 / 0.2) 42%, rgb(255 255 255 / 0) 72%, rgb(0 0 0 / 0.25) 100%);
    opacity: 0;
  }
</style>
