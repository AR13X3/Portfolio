---
/**
 * A blade's chip: a fragment of its product's own UI on its own ground, drawn at 120 x 155 design
 * px and scaled to the chip by --k (fan.css). Keyed by slug, like the words in parts.ts; a chapter
 * without a chip here fails the build. Every piece is decorative (the chip is aria-hidden); the
 * blade's link says what it is.
 *
 * CareVisor's chip holds the chapter's own app window (Demo.astro), small. Without the motion engine
 * it is this static copy; in full mode motion.ts swaps in a clone of the chapter's window at its first
 * frame, so the window that flies out of this chip is the one the chapter starts with.
 */
import Demo from '../../chapters/carevisor/Demo.astro';
import type { Blade } from './parts';

interface Props {
  blade: Blade;
}
const { blade } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const drawn = ['carevisor', 'halation', 'sitescore', 'bloodline', 'airpoint', 'comparebestai'];
if (!drawn.includes(blade.slug)) {
  throw new Error(`The Fan has no chip for "${blade.slug}": draw one in src/intros/fan/Chip.astro.`);
}
const pointer = 'M1 1v12l3.2-3 2.3 5 2-.9-2.2-4.9H10z';
---

<span class="frag">
  {
    blade.slug === 'carevisor' && (
      <>
        <span class="frag__ground" style={`background-color:${blade.bg};background-image:${blade.art ?? 'none'}`} />
        <span class="frag-cv__win" data-mini>
          <Demo />
        </span>
        <svg class="frag-cv__cursor" viewBox="0 0 11 16">
          <path d={pointer} fill="#000918" stroke="#fff" stroke-width="1" stroke-linejoin="round" />
        </svg>
      </>
    )
  }
  {
    blade.slug === 'halation' && (
      <>
        <span class="frag-ha__look" style={`background-image:url(${base}intros/fan/coral-reeds.webp)`} />
        <span class="frag-ha__glass" />
        <span class="frag-ha__panel">
          <b>Halation</b>
          <span class="frag-ha__row">
            Glass
            <span class="frag-ha__track">
              <i class="frag-ha__knob" />
            </span>
          </span>
        </span>
      </>
    )
  }
  {
    blade.slug === 'sitescore' && (
      <>
        <img class="frag-ss__map" src={`${base}intros/fan/hex.svg`} alt="" width="120" height="155" decoding="async" />
        <span class="frag-ss__pin" />
        <span class="frag-ss__card">
          <small>Wentworth Point</small>
          <b>$1.8M</b>
          <span>revenue over 36 months</span>
          <svg viewBox="0 0 64 14">
            <path d="M0 12 8 11 14 12 20 9 27 10 33 7 40 8 46 5 53 6 58 3 64 2" fill="none" stroke="#161616" stroke-width="1.2" stroke-linejoin="round" />
          </svg>
        </span>
      </>
    )
  }
  {
    blade.slug === 'bloodline' && (
      <>
        <span class="frag-bl__ground" style={`background-image:linear-gradient(180deg, rgb(6 17 12 / 0.55), rgb(6 17 12 / 0.9)), url(${base}shots/bloodline/bg-poster.webp)`} />
        <span class="frag-bl__card">
          <small>Haemoglobin</small>
          <b>
            118<em>g/L</em>
          </b>
          <span class="frag-bl__range">
            <i class="frag-bl__band" />
            <i class="frag-bl__mark" />
          </span>
          <span class="frag-bl__ticks">
            <span>120</span>
            <span>180</span>
          </span>
        </span>
        <span class="frag-bl__alert">
          <i />A result may need your review.
        </span>
      </>
    )
  }
  {
    blade.slug === 'airpoint' && (
      <>
        <span class="frag-ap__ground" />
        <span class="frag-ap__phone">
          <svg viewBox="0 0 30 30">
            <path d="M3 25c7 1 17-6 16-15-.6-5-7-6-8.4-1-1.8 6.5 4 15 14.4 13" fill="none" stroke="#3b69ff" stroke-width="3.2" stroke-linecap="round" />
            <circle cx="27.5" cy="22" r="2.3" fill="#3b69ff" />
          </svg>
          <b>Your S Pen, now a mouse.</b>
          <span>Next</span>
        </span>
        <svg class="frag-ap__cursor" viewBox="0 0 11 16">
          <path class="sh" d={pointer} transform="translate(.5 1.3)" fill="#000" fill-opacity=".42" />
          <path d={pointer} fill="#f4f4f1" stroke="#0d0f14" stroke-width="1" stroke-linejoin="round" />
        </svg>
      </>
    )
  }
  {
    blade.slug === 'comparebestai' && (
      <>
        <span class="frag-cb__ground" />
        <img class="frag-cb__robot" src={`${base}intros/fan/robot.webp`} alt="" width="260" height="308" decoding="async" />
        <span class="frag-cb__search">
          <i />
          Search AI tools…
        </span>
        <span class="frag-cb__score">
          <span>
            <span>Pricing</span>
            <span>9.1</span>
          </span>
          <span class="frag-cb__track">
            <i class="frag-cb__fill" />
          </span>
        </span>
      </>
    )
  }
</span>
