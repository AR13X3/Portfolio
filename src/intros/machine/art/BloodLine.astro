---
/** 04 BloodLine: the hero's range card. Its ruler is a rail: when the dot rolls past 130, the reading is flagged. */
---

<svg class="jm-art" viewBox="0 0 200 112">
  <rect x="0" y="-5.5" width="200" height="3" rx="1.5" fill="#9aa39e" />
  <rect data-r="bl-amber" x="0" y="-5.5" width="60" height="3" rx="1.5" fill="#e9ad4c" opacity="0" />
  <rect x="60" y="-5.5" width="100" height="3" fill="#7fc4d4" />
  <rect x=".5" y=".5" width="199" height="111" rx="16" fill="#0b1a13" stroke="rgb(220 238 226 / .18)" />
  <text x="60" y="16" text-anchor="middle" class="jm-tm" font-size="9.5" fill="#a6bcad">130</text>
  <text x="160" y="16" text-anchor="middle" class="jm-tm" font-size="9.5" fill="#a6bcad">180</text>
  <text x="14" y="45" class="jm-t" font-size="13.5" font-weight="600" fill="#eaf2ec">Haemoglobin</text>
  <circle class="jm-bl-now" cx="186" cy="12" r="3" fill="#dcebd2" />
  <g class="jm-bl-peek"><rect x="104" y="31" width="84" height="20" rx="10" fill="#e9ad4c" fill-opacity=".17" /><text x="146" y="44.6" text-anchor="middle" class="jm-t" font-size="10.5" font-weight="600" fill="#f3c57a">Outside range</text></g>
  <g data-r="bl-chip" opacity="0"><rect x="104" y="31" width="84" height="20" rx="10" fill="#e9ad4c" fill-opacity=".17" /><text x="146" y="44.6" text-anchor="middle" class="jm-t" font-size="10.5" font-weight="600" fill="#f3c57a">Outside range</text></g>
  <text x="13" y="93" class="jm-t" font-size="38" font-weight="300" fill="#eaf2ec" letter-spacing="-1">118</text>
  <text data-r="bl-val-amber" x="13" y="93" class="jm-t" font-size="38" font-weight="300" fill="#f3c57a" letter-spacing="-1" opacity="0">118</text>
  <text x="78" y="93" class="jm-t" font-size="13" font-weight="600" fill="#a6bcad">g/L</text>
</svg>
