---
/** Airpoint's status pill, hung from the pen's pivot: "Listening" until the point lights. */
---

<svg class="jm-ap-pill" viewBox="0 0 132 26">
  <rect x=".5" y=".5" width="131" height="25" rx="12.5" fill="#15181f" stroke="#2a2f3a" />
  <circle cx="14" cy="13" r="3.6" fill="#3b69ff" />
  <circle data-r="ap-dot-green" cx="14" cy="13" r="3.6" fill="#3dd68c" opacity="0" />
  <text data-r="ap-listen" x="25" y="17" class="jm-t" font-size="11" font-weight="600" fill="#a3a9b5">Listening</text>
  <text data-r="ap-point" x="25" y="17" class="jm-t" font-size="11" font-weight="600" fill="#f4f4f1" opacity="0">Pointing at Joy</text>
</svg>
