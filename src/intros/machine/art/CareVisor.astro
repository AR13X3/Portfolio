---
/** 01 CareVisor: the homepage demo's window on its prism. The last part: the dot presses its button. */
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<svg class="jm-art" viewBox="0 0 290 128">
  <defs>
    <clipPath id="jm-cv-clip"><rect width="290" height="128" rx="12" /></clipPath>
    <linearGradient id="jm-cv-tile" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#0052cc" /><stop offset="1" stop-color="#4a8fe8" /></linearGradient>
  </defs>
  <g clip-path="url(#jm-cv-clip)">
    <rect width="290" height="128" fill="#e9f0fa" />
    <image href={`${base}shots/carevisor/prism.webp`} x="-40" y="-30" width="370" height="231" preserveAspectRatio="xMidYMid slice" />
    <rect width="290" height="128" fill="rgb(241 246 252 / .32)" />
    <rect x="16" y="19" width="262" height="140" rx="10" fill="#000918" opacity=".07" />
    <rect x="14" y="14" width="262" height="140" rx="10" fill="#fff" stroke="#e4e6e4" />
    <path d="M14 24a10 10 0 0 1 10-10h242a10 10 0 0 1 10 10v10H14z" fill="#fafbfc" />
    <path d="M14 34H276" stroke="#eef0f4" />
    <circle cx="26" cy="24" r="3" fill="#f0645c" /><circle cx="35" cy="24" r="3" fill="#f5bd4f" /><circle cx="44" cy="24" r="3" fill="#61c454" />
    <rect x="108" y="18.5" width="78" height="11" rx="3" fill="#fff" stroke="#eef0f4" />
    <text x="147" y="26.4" text-anchor="middle" class="jm-t" font-size="6.4" font-weight="500" fill="#657084">app.carevisor.com</text>
    <rect x="14" y="34" width="48" height="120" fill="#fafbfc" /><path d="M62 34V154" stroke="#eef0f4" />
    <rect x="21" y="41" width="12" height="12" rx="3.5" fill="url(#jm-cv-tile)" />
    <rect x="36" y="44" width="20" height="3" rx="1.5" fill="#dfe4ec" /><rect x="36" y="49" width="13" height="2.4" rx="1.2" fill="#e8ecf3" />
    <rect x="19" y="60" width="39" height="11" rx="3" fill="#e8f0fe" /><rect x="23" y="64.5" width="22" height="2.4" rx="1.2" fill="#0052cc" />
    <rect x="23" y="78" width="26" height="2.4" rx="1.2" fill="#dfe4ec" /><rect x="23" y="89" width="20" height="2.4" rx="1.2" fill="#dfe4ec" /><rect x="23" y="100" width="24" height="2.4" rx="1.2" fill="#dfe4ec" /><rect x="23" y="111" width="18" height="2.4" rx="1.2" fill="#dfe4ec" />
    <text x="72" y="51" class="jm-t" font-size="12.5" font-weight="700" fill="#000918">Participants</text>
    <rect x="72" y="57" width="58" height="4" rx="2" fill="#e8ecf3" />
    <g class="jm-cv-ready"><rect x="168" y="40" width="98" height="24" rx="6" fill="none" stroke="#0052cc" stroke-width="1.5" stroke-opacity=".35" /></g>
    <rect data-r="cv-ring" x="168" y="40" width="98" height="24" rx="6" fill="none" stroke="#0052cc" stroke-width="1.5" opacity="0" />
    <g data-r="cv-btn"><rect class="jm-cv-btn-bg" x="168" y="40" width="98" height="24" rx="6" fill="#0052cc" /><text x="217" y="55.4" text-anchor="middle" class="jm-t" font-size="9.6" font-weight="600" fill="#fff">+ New participant</text></g>
    <rect x="72" y="72" width="194" height="26" rx="7" fill="#fff" stroke="#eef0f4" />
    <circle cx="86" cy="85" r="8" fill="#e8f0fe" /><text x="86" y="87.6" text-anchor="middle" class="jm-t" font-size="7" font-weight="700" fill="#0052cc">LC</text>
    <rect x="100" y="80" width="56" height="4" rx="2" fill="#e8ecf3" /><rect x="100" y="87.5" width="32" height="3" rx="1.5" fill="#eef1f6" />
    <rect x="72" y="104" width="194" height="26" rx="7" fill="#fff" stroke="#eef0f4" />
    <circle cx="86" cy="117" r="8" fill="#e8f0fe" /><text x="86" y="119.6" text-anchor="middle" class="jm-t" font-size="7" font-weight="700" fill="#0052cc">MT</text>
    <rect x="100" y="112" width="48" height="4" rx="2" fill="#e8ecf3" /><rect x="100" y="119.5" width="32" height="3" rx="1.5" fill="#eef1f6" />
  </g>
  <rect x=".5" y=".5" width="289" height="127" rx="12" fill="none" stroke="rgb(16 17 20 / .1)" />
</svg>
