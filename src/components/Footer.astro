---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<!-- The page's own footer, outside <main>, so it is exposed as the contentinfo landmark. -->
<footer class="site-footer">
  <div class="site-footer__inner">
    <p>© {year} {site.name}</p>
    <p>{site.role}, {site.location}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: 0 var(--gutter) clamp(24px, 4vh, 40px);
    background: var(--paper);
    color: var(--ink-2);
    font-size: 0.875rem;
  }

  html.mode-full .site-footer {
    padding-right: calc(var(--rail) + var(--gutter));
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    max-width: 1360px;
    margin: 0 auto;
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }
</style>
